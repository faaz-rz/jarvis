# Default local LLM: Qwen through Ollama
JARVIS_LLM_BACKEND=ollama
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.4
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TIMEOUT_SECONDS=300

# Optional alternative: direct GGUF through llama-cpp-python
# JARVIS_LLM_BACKEND=llama_cpp
# MISTRAL_MODEL_PATH=D:\models\your-chat-model.gguf

# Optional separate coding model
CODE_MODEL_PATH=D:\models\codellama-7b-instruct.Q5_K_M.gguf

# Runtime data and permissions
JARVIS_MEMORY_PATH=jarvis_memory.json
JARVIS_AUTOMATION_ROOT=.
JARVIS_GENERATED_DIR=.

# Speech: auto prefers bundled Vosk and falls back to Google
JARVIS_SPEECH_BACKEND=auto
VOSK_MODEL_PATH=Vm
JARVIS_WAKE_WORD=jarvis
VOICE_THRESHOLD=700
VOICE_SILENCE_SECONDS=1.5
VOICE_COMMAND_TIMEOUT=8

# Optional direct-GGUF model tuning
LLM_N_CTX=4096
LLM_N_THREADS=6
LLM_N_BATCH=512
LLM_N_GPU_LAYERS=20
LLM_VERBOSE=false
