# Default local LLM: Qwen through Ollama
JARVIS_LLM_BACKEND=ollama
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.4
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# Optional alternative: direct GGUF through llama-cpp-python
# JARVIS_LLM_BACKEND=llama_cpp
# JARVIS_GGUF_MODEL_PATH=/path/to/your-chat-model.gguf

# Optional separate GGUF coding model; Qwen is used when this is unset
# CODE_MODEL_PATH=/path/to/your-coding-model.gguf

# Runtime data and permissions
JARVIS_MEMORY_PATH=jarvis_memory.json
JARVIS_DB_PATH=jarvis_memory.db
JARVIS_MISSIONS_PATH=jarvis_memory.missions.db
JARVIS_MEMORY_SIMILARITY=0.30
JARVIS_AUDIT_PATH=jarvis_audit.jsonl
JARVIS_LOG_PATH=jarvis_system.log
JARVIS_AUTOMATION_ROOT=.
JARVIS_GENERATED_DIR=.
JARVIS_DASHBOARD_PORT=8765
# JARVIS_NO_BROWSER=true
TESSERACT_PATH=/path/to/tesseract

# Speech: auto prefers bundled Vosk and falls back to Google
JARVIS_SPEECH_BACKEND=auto
VOSK_MODEL_PATH=Vm
JARVIS_WAKE_WORD=jarvis
VOICE_THRESHOLD=700
VOICE_SILENCE_SECONDS=1.5
VOICE_COMMAND_TIMEOUT=8

# Optional direct-GGUF model tuning
LLM_N_CTX=4096
LLM_N_THREADS=6
LLM_N_BATCH=512
LLM_N_GPU_LAYERS=20
LLM_VERBOSE=false
